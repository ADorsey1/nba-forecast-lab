# Copy this structure into .streamlit/secrets.toml, or run scripts/setup_auth.py.
# Generate password_hash with scripts/setup_auth.py; do not commit real credentials.

[auth]
username = "replace-me"
password_hash = "pbkdf2_sha256$600000$replace-with-generated-salt$replace-with-generated-hash"
session_minutes = 480
max_attempts = 5
lockout_seconds = 60
